<ol class="cv-timeline">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    {% if content.startDate %}
      {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
      {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
    {% endif %}
    <li class="cv-timeline-item{% if endDate == 'Present' %} current{% endif %}">
      <div class="cv-timeline-meta">
        {% if content.startDate %}
          <span class="cv-date">{{ startDate }} — {{ endDate }}</span>
        {% endif %}
        {% if content.employmentType %}
          <span class="cv-chip">{{ content.employmentType }}</span>
        {% endif %}
      </div>
      <h6 class="cv-role">
        {% if content.url != blank %}
          <a href="{{ content.url }}">{{ content.position }}</a>
        {% else %}
          {{ content.position }}
        {% endif %}
      </h6>
      <p class="cv-org">
        {{ content.name }}
        {% if content.location %}
          <span class="cv-location"><i class="fa-solid fa-location-dot"></i> {{ content.location }}</span>
        {% endif %}
      </p>
      {% if content.summary %}
        <p class="cv-summary">{{ content.summary }}</p>
      {% endif %}
      {% if content.highlights.size > 0 %}
        {% if content.contributions.size > 0 %}
          <p class="cv-subhead">Main responsibilities</p>
        {% endif %}
        <ul class="items">
          {% for item in content.highlights %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if content.contributions.size > 0 %}
        <p class="cv-subhead">Key projects and contributions</p>
        <ul class="items">
          {% for item in content.contributions %}
            <li>
              <span class="item">{{ item }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ol>
